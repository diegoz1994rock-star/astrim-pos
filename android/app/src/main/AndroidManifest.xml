<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET: para hablar con la API del servidor ASTRIM.
         ACCESS_NETWORK_STATE: para poder distinguir "sin red" de "servidor
         caído" en mensajes de error futuros (Fase 8). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".AstrimApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Astrim"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic=true: el servidor ASTRIM corre en la red
             local del negocio por HTTP plano (ver API.md) — sin esto,
             Android bloquea por default cualquier conexión no-HTTPS desde
             API 28. Revisar en la Fase 8 si el despliegue final necesita
             HTTPS (certificado propio o proxy inverso). -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Astrim">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
